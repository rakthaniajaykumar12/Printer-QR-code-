# ==========================================
# Smart Xerox — Environment Configuration
# ==========================================

# Shop Details
SHOP_NAME=Smart Xerox
SHOP_TAGLINE=Fast Mobile Printing • Epson EcoTank L3250

# Database Connection (SQLite default for testing, or PostgreSQL for production)
# SQLite: sqlite:///./smart_xerox.db
# PostgreSQL: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./smart_xerox.db

# Security & Authentication (Replace with a strong random string in production)
SECRET_KEY=replace-with-a-very-long-random-secret-key-for-jwt-signing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Initial Owner Admin Account
# Set these before running the app for the first time
OWNER_USERNAME=admin
OWNER_PASSWORD=EnterStrongPasswordHere123!

# Storage and Limits
MAX_FILE_SIZE_MB=15
FILE_RETENTION_HOURS=24

# Default Per-Page Printing Rates (in INR ₹)
RATE_BW_PER_PAGE=2.0
RATE_COLOR_PER_PAGE=10.0

# CORS & Frontend URL
CORS_ORIGINS=*
FRONTEND_URL=https://your-shop-domain.com

# Server Port (assigned automatically by cloud hosts like Render/Railway)
PORT=8000
HOST=0.0.0.0
